<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /formation/
    
    # Set default index
    DirectoryIndex index.html

    # Jika file atau folder tidak ditemukan secara fisik, arahkan ke index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>
